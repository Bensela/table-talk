# Database Connection
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Application Settings
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Frontend URL (for CORS, and as the fallback public origin used for
# generated links when no Super Admin frontend_url setting is configured)
FRONTEND_URL=https://catalyst.madetoconnect.co

# Session Security
SESSION_SECRET=change_this_to_a_long_random_string
